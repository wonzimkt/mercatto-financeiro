# ─── Front-end (vão para o bundle público — é seguro e esperado) ───────────
# Supabase → Project Settings → API (ou Connect → App Frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "anon" (legado) ou "publishable" (sb_publishable_...). É uma chave pública:
# quem protege os dados é o RLS, que exige login + MFA verificado.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só em produção: o GitHub Actions preenche sozinho a partir do Pages.
# NEXT_PUBLIC_BASE_PATH=/mercatto-financeiro

# ─── NUNCA no front-end ───────────────────────────────────────────────────
# A service role key ignora o RLS. No GitHub Pages não existe servidor, então
# ela NÃO entra no build nem em variáveis do GitHub. Ela só é usada pela Edge
# Function `convidar-usuario`, onde o próprio Supabase a injeta como
# SUPABASE_SERVICE_ROLE_KEY — você não precisa copiá-la para lugar nenhum.
# Se quiser usá-la em scripts locais, mantenha só neste .env (que é ignorado
# pelo git):
# SUPABASE_SERVICE_ROLE_KEY=
